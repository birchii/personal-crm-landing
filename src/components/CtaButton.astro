---
import { APP_URL, cta } from "../content/landing";

interface Props {
  variant?: "hero" | "final";
}

const { variant = "hero" } = Astro.props;
---

<a
  href={APP_URL}
  class:list={[
    "relative mt-8 flex items-center gap-10 rounded-14 bg-ink px-30 py-17 text-17 font-semibold text-btn-ink lg:px-34 lg:py-19 lg:text-18",
    variant === "hero" ? "shadow-btn lg:shadow-btn-lg" : "shadow-btn-final lg:shadow-btn-final-lg",
  ]}
>
  {cta.label} <span aria-hidden="true" class="text-18 lg:text-19">↗</span>
</a>
<div class="relative -mt-6 text-13 text-subtle lg:-mt-8 lg:text-14">{cta.note}</div>
