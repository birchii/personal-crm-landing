---
import SectionHeading from "../components/SectionHeading.astro";
import { comparison } from "../content/landing";
---

<section class="border-t border-ink/8">
  <div class="mx-auto flex max-w-1200 flex-col gap-28 px-20 py-80 lg:gap-48 lg:px-32 lg:py-120">
    <SectionHeading eyebrow={comparison.eyebrow} title={comparison.title} titleClass="lg:max-w-760" />
    <div class="grid gap-10 lg:grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] lg:gap-14">
      {
        comparison.items.map((item) => (
          <div class="flex flex-col gap-6 rounded-18 border border-ink/9 p-18 lg:gap-10 lg:rounded-20 lg:p-26">
            <span class="text-15 text-subtle lg:text-16">{item.title}</span>
            <span class="text-16 leading-[1.4] text-muted lg:text-18">{item.text}</span>
          </div>
        ))
      }
      <div
        class="flex flex-col gap-6 rounded-18 bg-ink p-20 text-btn-ink shadow-highlight lg:gap-10 lg:rounded-20 lg:p-26 lg:shadow-highlight-lg"
      >
        <span class="flex items-center gap-8 text-15 font-semibold text-accent-strong lg:text-16">
          <span aria-hidden="true" class="box-content size-14 rounded-4 border-[1.5px] border-accent-border" />
          {comparison.highlight.title}
        </span>
        <span class="text-18 leading-[1.35] font-medium lg:text-20">{comparison.highlight.text}</span>
      </div>
    </div>
  </div>
</section>
